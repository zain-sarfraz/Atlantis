# ─── Database ────────────────────────────────────────────────────────────────
# MySQL (required)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3307/atlantis_db"

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET="change-this-to-a-long-random-secret-at-least-32-chars"
JWT_REFRESH_SECRET="change-this-refresh-secret-too-at-least-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:4173"

# ─── File Uploads ─────────────────────────────────────────────────────────────
UPLOAD_DIR="uploads"
MAX_FILE_SIZE_MB=10

# ─── Exchange Rate API (optional — for auto-sync) ─────────────────────────────
# Get a free key from https://exchangeratesapi.io or https://openexchangerates.org
EXCHANGE_RATE_API_KEY=""
EXCHANGE_RATE_API_URL="https://api.exchangerate-api.com/v4/latest/AED"

# ─── Hotel Fees ───────────────────────────────────────────────────────────────
SERVICE_CHARGE_RATE=0.10
MUNICIPALITY_FEE_RATE=0.07
VAT_RATE=0.05

# ─── Lodgify Channel Manager ──────────────────────────────────────────────────
# API key from Lodgify → Settings → Public API
LODGIFY_API_KEY=""
# v2 for reads (properties, availability, rates, bookings)
LODGIFY_BASE_URL="https://api.lodgify.com/v2"
# v1 for creating bookings (POST /reservation/booking)
LODGIFY_V1_BASE_URL="https://api.lodgify.com/v1"
# When set, availability + booking sync only this Lodgify property ID
# (Limiria Villa Zanzibar)
LODGIFY_PROPERTY_ID=714507
# Optional: secrets returned by POST /webhooks/v1/subscribe (one per event).
# Comma-separated list is supported. Used to verify ms-signature header.
# Leave empty to skip verification in dev.
LODGIFY_WEBHOOK_SECRET=""
# Optional override for register script target URL
# LODGIFY_WEBHOOK_TARGET_URL="https://xxxx.ngrok-free.dev/api/webhooks/lodgify"
